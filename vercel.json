{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/chat",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/telegram/webhook",
      "destination": "/api/index"
    },
    {
      "source": "/telegram/link-code",
      "destination": "/api/index"
    }
  ],
  "outputDirectory": "public"
}
