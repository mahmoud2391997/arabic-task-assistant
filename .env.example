PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://assistant:assistant@localhost:5433/assistant
# For cloud database TLS: set true and supply a CA if your provider requires one.
DATABASE_SSL=false
DATABASE_CA_FILE=
# Evaluation mode accepts the supplied user_id. For deployment set AUTH_MODE=token
# and map secrets to employees; user_id must match the authenticated identity.
AUTH_MODE=demo
AUTH_TOKENS_JSON={}
# OpenAI-compatible provider supporting /chat/completions and JSON mode.
# Choose your provider's base URL (usually ending in /v1), model ID and key.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# Optional generic provider key; GROQ_API_KEY takes precedence.
AI_API_KEY=

# Host port for the Docker PostgreSQL service.
POSTGRES_PORT=5433

# Telegram integration (optional). Store real tokens only in ignored env files.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# secure_link requires verified access; demo_id permits ID-only test selection.
TELEGRAM_IDENTITY_MODE=secure_link
